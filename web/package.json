{
  "name": "aether-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node ../scripts/sync-mp-assets.mjs",
    "sync:mp": "node ../scripts/sync-mp-assets.mjs",
    "fetch:models": "node ../scripts/fetch-models.mjs",
    "build:wasm": "bash ../scripts/build-wasm.sh release --both",
    "build:wasm:dev": "bash ../scripts/build-wasm.sh dev --both",
    "build:wasm:threads": "bash ../scripts/build-wasm.sh release --threads",
    "fixture": "node ../scripts/make-fixture-video.mjs",
    "dev": "bash ../scripts/build-wasm.sh release --if-missing --both && vite",
    "build": "bash ../scripts/build-wasm.sh release --if-missing --both && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "cd .. && cargo test --workspace",
    "test:e2e": "node ../scripts/make-fixture-video.mjs && playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
